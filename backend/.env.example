# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Kolors Virtual Try-On (VTON) Engine Configuration
# Supported providers:
# - 'fal-ai': (Recommended Production API) Uses fal-ai/kling/v1-5/kolors-virtual-try-on with dedicated GPU infrastructure.
# - 'hf-kolors': Uses official Kwai-Kolors/Kolors-Virtual-Try-On Gradio space on Hugging Face.
# - 'custom-api': Uses dedicated self-hosted GPU endpoint (requires KOLORS_API_URL).
# - 'replicate': Uses Replicate cloud API (requires REPLICATE_API_TOKEN).
KOLORS_PROVIDER=fal-ai

# 1. Fal.ai Kolors API Configuration (Recommended)
# Obtain your key at: https://fal.ai/dashboard/keys
FAL_KEY=
FAL_KOLORS_ENDPOINT=https://fal.run/fal-ai/kling/v1-5/kolors-virtual-try-on

# 2. Hugging Face Kwai-Kolors API Configuration (Alternative)
# Obtain your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=
KOLORS_HF_SPACE_ID=Kwai-Kolors/Kolors-Virtual-Try-On
HF_BACKUP_SPACE_ID=yisol/IDM-VTON
# Set to 'true' to allow connecting to public Hugging Face ZeroGPU community space when HF_TOKEN is empty
ALLOW_COMMUNITY_HF=true

# Denoise Steps (default 22: safely balances quality and speed within GPU lease)
VTON_DENOISE_STEPS=22

# 3. Dedicated / Self-Hosted GPU Endpoint (Optional: RunPod, Modal, ComfyUI, etc.)
KOLORS_API_URL=
KOLORS_API_KEY=

# 4. Replicate API Configuration (Optional alternative provider)
REPLICATE_API_TOKEN=
REPLICATE_KOLORS_MODEL=kwaivgi/kolors-virtual-try-on

# 5. AnyWear / Decart AI Live Virtual Try-On Configuration (Live Camera Neural Video)
# AnyWear is powered by Decart AI's Lucy V-TON video foundation model (https://anywear.live / https://decart.ai)
# Direct in-website streaming requires an enterprise merchant partnership and domain whitelist with Decart.
# Register and request API access at: https://decart.ai
DECART_API_KEY=
DECART_MERCHANT_DOMAIN=fitfusion.com

# Firebase Admin SDK Configuration (Optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
