# =====================================================================
# FITFUSION FRONTEND ENVIRONMENT CONFIGURATION (VITE)
# =====================================================================

# API Backend URL
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------
# Firebase Web Client & Firestore Configuration
# Replace these placeholder values with your Firebase Project credentials.
# In production, obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app.
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
